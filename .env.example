# Server Port
# Port number for SSE mode server
# Default: 3000
PORT=3000

# MCP Transport Mode
# Set to 'sse' to enable Server-Sent Events mode (for HTTP-based connections)
# Leave empty or unset to use stdio mode (default, for standard MCP clients)
MCP_TRANSPORT=sse

# Yunxiao Access Token
# Personal access token for Alibaba Cloud Yunxiao (DevOps) API
# Required for all API operations
# Get your token at: https://help.aliyun.com/zh/yunxiao/developer-reference/obtain-personal-access-token
YUNXIAO_ACCESS_TOKEN=your_yunxiao_access_token

# Yunxiao API Base URL
# Default: https://openapi-rdc.aliyuncs.com
# For private deployment, set to your custom API endpoint
# Example: YUNXIAO_API_BASE_URL=https://your-company-yunxiao.example.com
YUNXIAO_API_BASE_URL=
